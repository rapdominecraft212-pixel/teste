import os
import sys
import shutil
import time as time_module
from pathlib import Path
from concurrent.futures import ThreadPoolExecutor, as_completed

from Playwright import qwen_capa, qwen_titulo
from Playwright.qwen_reply import QwenReply
from src import colocar_linha
import src.cortar_video as cortar_video
import src.video_popup_linear as video_popup_linear
from bot.log_utils import log


BASE_DIR = Path(__file__).resolve().parent.parent
QWEN_PERFIL_BASE = BASE_DIR / "Playwright" / "chrome_profile"

TIMINGS_PADRAO = {
    "popup_1_in": 0.0,
    "popup_1_out": 7.0,
    "transition_dur": 1.0,
    "popup_fade_in": 1.5,
    "text_fade_dur": 0.5,
}


def _paralelo_disponivel():
    return all(
        (QWEN_PERFIL_BASE.parent / f"chrome_profile_{i}").exists()
        for i in (1, 2, 3)
    )


def _exec_capa(video_path, perfil):
    qr = QwenReply(perfil=perfil, headless=True)
    try:
        return qwen_capa.analisar_com_instancia(qr, video_path)
    finally:
        qr.close()


def _exec_titulo(video_path, perfil):
    qr = QwenReply(perfil=perfil, headless=True)
    try:
        return qwen_titulo.analisar_com_instancia(qr, video_path)
    finally:
        qr.close()


def _exec_linha(video_path, perfil):
    qr = QwenReply(perfil=perfil, headless=True)
    try:
        return colocar_linha.analisar_com_instancia(qr, video_path)
    finally:
        qr.close()


def processar_video(video_path: str, chat_id: int, timings: dict | None = None, on_render_progress=None, parallel=True) -> str:
    timings = timings or TIMINGS_PADRAO
    video_name = Path(video_path).name
    cid = str(chat_id)
    video_size = os.path.getsize(video_path)
    log.info(f"Pipeline iniciado — {video_name} ({video_size/1024/1024:.1f}MB) chat={cid}")
    log.start_timer("pipeline_total")

    log.info(f"[1/4] Analisando video via Qwen...")
    log.start_timer("analise")

    texto_capa = texto_titulo = None
    y1 = y2 = None

    if parallel and _paralelo_disponivel():
        perfis = tuple(str(QWEN_PERFIL_BASE.parent / f"chrome_profile_{i}") for i in (1, 2, 3))
        log.info(f"  Modo paralelo com 3 perfis")
        with ThreadPoolExecutor(max_workers=3) as pool:
            fut_capa = pool.submit(_exec_capa, video_path, perfis[0])
            fut_titulo = pool.submit(_exec_titulo, video_path, perfis[1])
            fut_linha = pool.submit(_exec_linha, video_path, perfis[2])
            for future in as_completed((fut_capa, fut_titulo, fut_linha)):
                future.result()
            texto_capa = fut_capa.result()
            texto_titulo = fut_titulo.result()
            y1, y2 = fut_linha.result()
    else:
        if parallel:
            log.info(f"  Perfis paralelos nao encontrados — usando modo sequencial")
        qr = QwenReply(headless=True)
        try:
            texto_capa = qwen_capa.analisar_com_instancia(qr, video_path)
            texto_titulo = qwen_titulo.analisar_com_instancia(qr, video_path)
            y1, y2 = colocar_linha.analisar_com_instancia(qr, video_path)
        finally:
            qr.close()

    log.info(f"[1/4] Analise OK — capa=\"{texto_capa}\" corte_y={y1}-{y2} {log.timer_info('analise')}")

    log.info(f"[2/4] Cortando video...")
    log.start_timer("corte")
    cortado_dir = BASE_DIR / "data" / "cortado" / cid
    editado_dir = BASE_DIR / "data" / "editado" / cid
    biblioteca_dir = BASE_DIR / "data" / "biblioteca" / cid
    cortado_path = cortar_video.cortar_video(
        video_path, y1, y2,
        output_dir=str(cortado_dir)
    )
    cortado_size = os.path.getsize(cortado_path)
    log.info(f"[2/4] Corte OK — {Path(cortado_path).name} ({cortado_size/1024/1024:.1f}MB) {log.timer_info('corte')}")

    log.info(f"[3/4] Renderizando video final com popups...")
    log.start_timer("render")
    final_path = str(Path(video_popup_linear.criar_video(
        input_path=cortado_path,
        output_dir=str(editado_dir),
        titulo=texto_capa,
        subtitulo=texto_titulo,
        on_render_progress=on_render_progress,
        **timings,
    )).resolve())

    if not os.path.exists(final_path):
        raise RuntimeError(f"arquivo final nao gerado: {final_path}")

    final_size = os.path.getsize(final_path)
    ratio = final_size / video_size if video_size else 0
    log.info(f"[3/4] Render OK — {Path(final_path).name} ({final_size/1024/1024:.1f}MB) {log.timer_info('render')}")

    log.info(f"[4/4] Arquivando e limpando...")
    biblioteca_dir.mkdir(parents=True, exist_ok=True)
    biblioteca_path = biblioteca_dir / video_name
    shutil.move(video_path, str(biblioteca_path))
    log.debug(f"  Original movido para: {biblioteca_path}")

    for f in cortado_dir.iterdir():
        try:
            os.remove(str(f))
            log.debug(f"  Removido cortado: {f.name}")
        except Exception as e:
            log.warn(f"  Erro ao remover {f.name}: {e}")

    log.info(f"Pipeline concluido! {log.timer_info('pipeline_total')} (compressao total {ratio:.1%})")
    return final_path


def main():
    upload_base = BASE_DIR / "data" / "upload"
    if not upload_base.exists():
        print("Nenhum video encontrado (data/upload/ nao existe)")
        sys.exit(1)

    user_dirs = sorted(d for d in upload_base.iterdir() if d.is_dir())
    if not user_dirs:
        print("Nenhum video encontrado em data/upload/")
        sys.exit(1)

    videos = []
    for user_dir in user_dirs:
        videos.extend(sorted(user_dir.glob("*.mp4")))

    if not videos:
        print("Nenhum video encontrado em data/upload/")
        sys.exit(1)

    print(f"Videos encontrados: {len(videos)}")
    sucessos = 0
    falhas = 0
    for v in videos:
        chat_id = int(v.parent.name)
        try:
            processar_video(str(v), chat_id=chat_id)
            sucessos += 1
        except Exception as e:
            print(f"ERRO ao processar {v.name}: {e}")
            falhas += 1

    print(f"Resumo: {sucessos} sucesso(s), {falhas} falha(s) em {len(videos)} video(s)")


if __name__ == "__main__":
    main()
