TELEGRAM_API_BASE_URL=https://api.telegram.org

# === Pipeline Paralelo (Fase 3) ===
# USE_PIPELINE=True: 2 esteiras concorrentes (prepare + render)
# USE_PIPELINE=False: modo sequencial legado (fallback)
USE_PIPELINE=True

# MAX_PARALLEL_JOBS: número máximo de jobs simultâneos
# Cada job usa 2 contas Qwen + 1 thread de render (FFmpeg)
# i3-2120 (2 cores/4 threads, 8GB RAM): RECOMENDADO = 2
# Se 0 ou não definido: automático (total_contas // 2)
MAX_PARALLEL_JOBS=2

# MAX_READY_TO_RENDER: limite de jobs prontos para render (fila B)
# Quando atinge, esteira A pausa até B consumir.
# Padrão 3 — aumenta se render for muito mais rápido que Qwen
MAX_READY_TO_RENDER=3

# FFMPEG_THREADS_PER_RENDER: threads FFmpeg por render
# Se vazio: automático (cpu_count // num_render)
# Para i3-2120 com 2 renders: 2 threads por render
FFMPEG_THREADS_PER_RENDER=2
