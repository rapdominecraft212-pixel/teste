# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_API_BASE_URL=https://api.telegram.org

# === Pipeline Paralelo (Fase 3) ===
# USE_PIPELINE=True: 2 esteiras concorrentes (prepare + render)
# USE_PIPELINE=False: modo sequencial legado (fallback)
USE_PIPELINE=True

# MAX_READY_TO_RENDER: limite de jobs prontos para render (fila B)
# Quando atinge, esteira A pausa até B consumir.
# Padrão 3 — aumenta se render for muito mais rápido que Qwen
MAX_READY_TO_RENDER=3
